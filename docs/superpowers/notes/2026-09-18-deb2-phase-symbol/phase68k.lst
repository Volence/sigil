       1/       0 :                     ; phase68k.asm -- THE QUESTION: when a label sits inside a PHASE block, what
       2/       0 :                     ; address does asl print for it in its listing's symbol table -- the phase
       3/       0 :                     ; (VMA) address, or the physical (LMA) one?
       4/       0 :                     ;
       5/       0 :                     ; Shaped after the real case this measures: aeon's `soundbankhead.emp` section
       6/       0 :                     ; `(cpu: m68000, vma: $8000)` at map anchor lma $B8000, which the AS twin wrote
       7/       0 :                     ; as a `phase 08000h` bracket around the 5 engine-table heads.
       8/       0 :                     ;
       9/       0 :                     ; THE TWO CANDIDATE ANSWERS ARE FIVE DIGITS APART AND CANNOT BE MISREAD:
      10/       0 :                     ;   phase answer     PhasedHead : 8000
      11/       0 :                     ;   physical answer  PhasedHead : B8002
      12/       0 :                     ;
      13/       0 :                     ; THE CONTROLS are outside any PHASE bracket at addresses derivable by hand:
      14/       0 :                     ;   CtrlBefore : B8000   (org, first thing emitted)
      15/       0 :                     ;   CtrlAfter  : B8004   (org + 2 + 2, PHASE moves no physical bytes)
      16/       0 :                     ; A probe that listed nothing at all, or listed an empty table, is therefore
      17/       0 :                     ; distinguishable from one that answered `8000`: the controls would be gone too.
      18/       0 :                     	cpu	68000
      19/   B8000 :                     	org	$B8000
      20/   B8000 :                     CtrlBefore:
      21/   B8000 : 1111                	dc.w	$1111
      22/    8000 :                     	phase	$8000
      23/    8000 :                     PhasedHead:
      24/    8000 : 2222                	dc.w	$2222
      25/   B8004 :                     	dephase
      26/   B8004 :                     CtrlAfter:
      27/   B8004 : 3333                	dc.w	$3333
      28/   B8006 :                     	end
